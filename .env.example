# Copy to .env (gitignored) and tweak as needed. Used by `make` and
# `docker compose`. All values are optional — the defaults work for a
# localhost install.

# Set to true when serving over HTTPS so session cookies get the Secure
# flag. Leave false for plain http://localhost.
COOKIE_SECURE=false

# IANA timezone for due-date / reminder calculations. Defaults to UTC.
TZ=UTC
